<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Filtros superiores: Todas / Atrasos / Lotação / Insegurança -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipTodas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:text="Todas"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipAtrasos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:text="Atrasos"
                    android:textColor="#0B2545"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipLotacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:text="Lotação"
                    android:textColor="#0B2545"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipInseguranca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:text="Insegurança"
                    android:textColor="#0B2545"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- CARTÃO 1: Mapa de calor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chart_icon"
                    android:contentDescription="Mapa de calor"
                    android:padding="7dp"
                    android:src="@drawable/ic_fire_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Mapa de calor"
                    android:textColor="#0B2545"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="Queixas acumuladas junto às paragens"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Mapa esquemático + etiquetas das paragens + barra Baixa/Crítica -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Linha UBI"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_heatmap_ubi" />

                <!-- Etiquetas das 6 paragens -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="66dp"
                    android:text="Pólo IV · Saúde"
                    android:textColor="#0B2545"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="78dp"
                    android:layout_marginEnd="102dp"
                    android:text="Pólo das Engenharias"
                    android:textColor="#0B2545"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="66dp"
                    android:layout_marginTop="134dp"
                    android:text="Pólo I · Reitoria"
                    android:textColor="#0B2545"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="142dp"
                    android:layout_marginTop="184dp"
                    android:text="Praça do Município"
                    android:textColor="#0B2545"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="96dp"
                    android:layout_marginTop="236dp"
                    android:text="Fórum Covilhã"
                    android:textColor="#0B2545"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="58dp"
                    android:layout_marginBottom="44dp"
                    android:text="Estação CP"
                    android:textColor="#0B2545"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Barra branca flutuante: Baixa -> Crítica -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_card_white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Baixa"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="7dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_heatmap_legend" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crítica"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Top 3 paragens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_rank_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopStop1Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Pólo das Engenharias (UBI)"
                    android:textColor="#0B2545"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopStop1Pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#0B2545"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_rank_badge"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopStop2Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Pólo I · Reitoria da UBI"
                    android:textColor="#0B2545"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopStop2Pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85%"
                    android:textColor="#0B2545"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_rank_badge"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopStop3Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Praça do Município"
                    android:textColor="#0B2545"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopStop3Pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60%"
                    android:textColor="#0B2545"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARTÃO 2: Horas críticas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chart_icon"
                    android:contentDescription="Horas críticas"
                    android:padding="7dp"
                    android:src="@drawable/ic_grid_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Horas críticas"
                    android:textColor="#0B2545"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:text="Escolhe a paragem e toca numa hora"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Seletor horizontal das paragens -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="Estação CP"
                        android:textColor="#0B2545"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="Fórum Covilhã"
                        android:textColor="#0B2545"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="Praça do Município"
                        android:textColor="#0B2545"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="Pólo das Engenharias"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Gráfico de 16 horas (7h às 22h) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <!-- 7h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="52dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FDE047" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="7" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 8h (selecionada - crítica) -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="15dp" android:layout_height="108dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#C83214" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="8" android:textColor="#0B2545" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- 9h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="88dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#F97316" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="9" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 10h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="60dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FBBF24" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="10" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 11h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="40dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FEF08A" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="11" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 12h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="84dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#F97316" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="12" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 13h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="96dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#EA580C" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="13" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 14h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="82dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#F97316" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="14" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 15h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="42dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FEF08A" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="15" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 16h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="50dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FDE047" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="16" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 17h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="76dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FB923C" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="17" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 18h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="98dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#DC2626" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="18" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 19h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="78dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FB923C" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="19" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 20h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="48dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FDE047" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="20" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 21h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="36dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FEF08A" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="21" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>

                <!-- 22h -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                    <View android:layout_width="14dp" android:layout_height="32dp" android:background="@drawable/bg_trend_bar" android:backgroundTint="#FEF9C3" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="22" android:textColor="#64748B" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Caixa de detalhe da hora selecionada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_fire_badge"
                    android:contentDescription="Alerta"
                    android:padding="9dp"
                    android:src="@drawable/ic_fire_white" />

                <TextView
                    android:id="@+id/tvHourDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="Pólo das Engenharias (UBI) · 8h: cerca de 36 reportes (nível crítico). Pico das entradas nos polos da UBI."
                    android:textColor="#334155"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>